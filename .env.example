# Crée une base Redis dans Vercel Marketplace (Upstash), puis recopie les
# variables générées ici. Ne versionne jamais les vraies valeurs.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your-token

# Google AdSense : identifiant ca-pub et numéros des deux blocs responsives.
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-0000000000000000
NEXT_PUBLIC_GOOGLE_ADSENSE_TOP_SLOT=0000000000
NEXT_PUBLIC_GOOGLE_ADSENSE_BOTTOM_SLOT=0000000000
